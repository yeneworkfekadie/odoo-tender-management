    <record id="evaluation_report_action" model="ir.actions.report">
        <field name="name">Evaluation Report</field>
        <field name="model">tender.evaluation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tender_management.evaluation_report_template</field>
        <field name="binding_model_id" ref="model_tender_evaluation"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Vendor Performance Report -->
    <record id="vendor_performance_report_action" model="ir.actions.report">
        <field name="name">Vendor Performance Report</field>
        <field name="model">tender.vendor</field>
