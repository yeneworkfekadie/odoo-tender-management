<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tender Approval Views -->
    <record id="tender_approval_tree" model="ir.ui.view">
        <field name="name">tender.approval.tree</field>
        <field name="model">tender.approval</field>
        <field name="arch" type="xml">
            <tree string="Tender Approvals" decoration-success="status=='approved'" decoration-danger="status=='rejected'" decoration-info="status=='under_review'">
                <field name="tender_id"/>
                <field name="evaluation_id"/>
                <field name="winner_vendor_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="tender_approval_form" model="ir.ui.view">
        <field name="name">tender.approval.form</field>
        <field name="model">tender.approval</field>
        <field name="arch" type="xml">
            <form string="Tender Approval">
                <header>
                    <button name="action_send_for_approval" string="Send for Approval" type="object" states="pending" class="oe_highlight" groups="tender_management.group_tender_manager"/>
                    <button name="action_approve" string="Approve" type="object" states="under_review" class="oe_highlight" groups="tender_management.group_tender_approver"/>
                    <button name="action_reject" string="Reject" type="object" states="under_review" groups="tender_management.group_tender_approver"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,under_review,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="tender_id"/>
                            <field name="evaluation_id"/>
                            <field name="winning_bid_id"/>
                        </group>
                        <group>
                            <field name="winner_vendor_id"/>
                            <field name="approval_date"/>
                            <field name="approved_by"/>
                        </group>
                    </group>
                    <group string="Approval Notes" colspan="4">
                        <field name="approval_notes" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Approval Chain">
                            <field name="approval_lines" nolabel="1">
                                <tree editable="bottom">
                                    <field name="sequence"/>
                                    <field name="approval_level"/>
                                    <field name="approver_id"/>
                                    <field name="status"/>
                                    <field name="approval_date"/>
                                    <field name="comments"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="tender_approval_action" model="ir.actions.act_window">
        <field name="name">Tender Approvals</field>
        <field name="res_model">tender.approval</field>
        <field name="view_mode">tree,form</field>
    </record>
