<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tender Vendor Views -->
    <record id="tender_vendor_tree" model="ir.ui.view">
        <field name="name">tender.vendor.tree</field>
        <field name="model">tender.vendor</field>
        <field name="arch" type="xml">
            <tree string="Tender Vendors" decoration-danger="rating &lt; 3">
                <field name="partner_id"/>
                <field name="category"/>
                <field name="rating"/>
                <field name="total_bids"/>
                <field name="successful_bids"/>
                <field name="on_time_delivery_rate"/>
            </tree>
        </field>
    </record>

    <record id="tender_vendor_form" model="ir.ui.view">
        <field name="name">tender.vendor.form</field>
        <field name="model">tender.vendor</field>
        <field name="arch" type="xml">
            <form string="Tender Vendor Profile">
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="registration_number"/>
                            <field name="category"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="rating" widget="float_star" readonly="1"/>
                            <field name="on_time_delivery_rate"/>
                            <field name="quality_rating"/>
                        </group>
                    </group>
                    <group string="Performance" colspan="4">
                        <group>
                            <field name="total_bids" readonly="1"/>
                            <field name="successful_bids" readonly="1"/>
                        </group>
                        <group>
                            <field name="failed_bids" readonly="1"/>
                        </group>
                    </group>
                    <group string="Compliance & Capacity" colspan="4">
                        <group>
                            <field name="tax_compliant"/>
                            <field name="insurance_compliant"/>
                            <field name="financial_capacity"/>
                        </group>
                        <group>
                            <field name="bank_references"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Certifications">
                            <field name="certification_ids" nolabel="1">
                                <tree editable="bottom">
                                    <field name="name"/>
                                    <field name="issue_date"/>
                                    <field name="expiry_date"/>
                                    <field name="issuing_body"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tender_vendor_search" model="ir.ui.view">
        <field name="name">tender.vendor.search</field>
        <field name="model">tender.vendor</field>
        <field name="arch" type="xml">
            <search string="Tender Vendor">
                <field name="partner_id"/>
                <field name="registration_number"/>
                <separator/>
                <filter name="compliant" string="Compliant" domain="[('tax_compliant','=',True),('insurance_compliant','=',True)]"/>
                <filter name="active" string="Active" domain="[('active','=',True)]"/>
                <group expand="0" string="Group By">
                    <filter name="group_by_category" string="Category" context="{'group_by':'category'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="tender_vendor_action" model="ir.actions.act_window">
        <field name="name">Tender Vendors</field>
        <field name="res_model">tender.vendor</field>
        <field name="view_mode">tree,form</field>
    </record>
